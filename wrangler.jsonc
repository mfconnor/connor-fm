{
  "name": "connor-fm",
  "compatibility_date": "2026-08-26",
  "main": "./_worker.js",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // Everything (content, uploads, stats, codes, comments, questions)
  // lives in this one KV namespace — no paid features needed.
  "kv_namespaces": [
    {
      "binding": "CONNOR_DATA",
      "id": "0cd55b70587548b28b263bd00db73d23"
    }
  ]
}
